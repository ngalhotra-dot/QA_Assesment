            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// ✅ STEP 1: Increment loopCounter
def counter = vars.get(&quot;loopCounter&quot;) ?: &quot;0&quot;
int count = counter.toInteger()

count = count + 1
vars.put(&quot;loopCounter&quot;, count.toString())

log.info(&quot;✅ Loop Iteration: &quot; + count)

// ✅ HARD SAFETY STOP (important fix)
if (count &gt;= 30) {
    vars.put(&quot;loopCounter&quot;, &quot;30&quot;)   // force stop boundary
}

// ✅ STEP 2: Get response
def response = prev.getResponseDataAsString()?.trim() ?: &quot;&quot;
log.info(&quot;Response: &quot; + response)

def nextInput = &quot;&quot;
def descSent = vars.get(&quot;descSent&quot;) ?: &quot;false&quot;

// ✅ KEYWORDS
def numberKeywords = [
    &quot;please select&quot;,
    &quot;let me know the number&quot;,
    &quot;please specify the number&quot;
]

def yesKeywords = [
    &quot;does this accurately reflect&quot;,
    &quot;would you like a recommendation&quot;,
    &quot;would you like me to create jobs&quot;,
    &quot;could you confirm&quot;
]

def searchTPIKeywords = [
    &quot;would you like me to search tpis&quot;
]

def refineTPIKeywords = [
    &quot;the tpi search for job 2 was successful&quot;,
    &quot;the tpi search for the selected job was successful&quot;
]

def descKeywords = [
    &quot;statement&quot;,
    &quot;customer statement&quot;,
    &quot;no customer statement&quot;,
    &quot;the workshop order currently has no customer statement provided&quot;
]

def respLower = response.toLowerCase()

// ✅ DECISION LOGIC
if (numberKeywords.any { respLower.contains(it) }) {
    nextInput = &quot;1&quot;
}
else if (searchTPIKeywords.any { respLower.contains(it) }) {
    nextInput = &quot;Search TPI for job 2&quot;
}
else if (refineTPIKeywords.any { respLower.contains(it) }) {
    nextInput = &quot;Refine TPI for job 2&quot;
}
else if (descSent == &quot;false&quot; &amp;&amp; descKeywords.any { respLower.contains(it) }) {

    def textValue = vars.get(&quot;p_Text_escaped&quot;) ?: &quot;Default description&quot;

    nextInput = textValue
    vars.put(&quot;descSent&quot;, &quot;true&quot;)

    log.info(&quot;✅ DESCRIPTION TRIGGERED&quot;)
}
else if (yesKeywords.any { respLower.contains(it) }) {
    nextInput = &quot;Yes&quot;
}

// ✅ FALLBACK
if (!nextInput) {
    nextInput = &quot;Yes&quot;
}

// ✅ SAVE FINAL VALUE
vars.put(&quot;nextMessage&quot;, nextInput)

log.info(&quot;✅ Next Message: &quot; + nextInput)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
